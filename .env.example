# Copia este archivo a .env y añade tus claves localmente.
# Nunca publiques el archivo .env ni incluyas claves en este archivo.
# Esta clave habilita respuestas generativas del chat; sin ella se usa modo local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Esta clave es necesaria solo para ejecutar la evaluación Ragas.
GOOGLE_API_KEY=
RAGAS_LLM_MODEL=gemini-3.8-flash
RAGAS_EMBEDDING_MODEL=models/gemini-embedding-001

# Parámetros del pipeline (útiles para repetir y comparar evaluaciones).
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
